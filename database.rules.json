{
  "rules": {
    ".read": true,
    ".write": false,
    "liveStatus": {
      ".write": "auth != null && auth.uid == '__ADMIN_UID__'",
      ".validate": "newData.hasChildren(['team', 'song', 'updatedAt']) && newData.child('team').isString() && newData.child('song').isString() && newData.child('updatedAt').isNumber()"
    },
    "interactionEnabled": {
      ".write": "auth != null && auth.uid == '__ADMIN_UID__'",
      ".validate": "newData.isBoolean()"
    },
    "chatEnabled": {
      ".write": "auth != null && auth.uid == '__ADMIN_UID__'",
      ".validate": "newData.isBoolean()"
    },
    "chatVisible": {
      ".write": "auth != null && auth.uid == '__ADMIN_UID__'",
      ".validate": "newData.isBoolean()"
    },
    "hypeTarget": {
      ".write": "auth != null && auth.uid == '__ADMIN_UID__'",
      ".validate": "newData.isNumber() && newData.val() > 0"
    },
    "hypeAuto": {
      ".write": "auth != null && auth.uid == '__ADMIN_UID__'",
      ".validate": "newData.isBoolean()"
    },
    "presence": {
      "$clientId": {
        ".write": true,
        ".validate": "newData.val() == true"
      }
    },
    "hearts": {
      ".write": "auth != null && auth.uid == '__ADMIN_UID__'",
      "$songId": {
        ".write": "(!data.exists() && newData.val() <= 100) || (data.exists() && newData.val() > data.val() && newData.val() - data.val() <= 100)",
        ".validate": "newData.isNumber() && newData.val() >= 0"
      }
    },
    "hypeCount": {
      ".write": "auth != null && auth.uid == '__ADMIN_UID__'",
      "$team": {
        ".write": "(!data.exists() && newData.val() <= 100) || (data.exists() && newData.val() > data.val() && newData.val() - data.val() <= 100)",
        ".validate": "newData.isNumber() && newData.val() >= 0"
      }
    },
    "hypeExplodedTeams": {
      ".write": "auth != null && auth.uid == '__ADMIN_UID__'",
      "$team": {
        ".write": "!data.exists()",
        ".validate": "newData.val() == true"
      }
    },
    "raffle": {
      ".write": "auth != null && auth.uid == '__ADMIN_UID__'",
      "nextNumber": {
        ".write": "(!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1)",
        ".validate": "newData.isNumber()"
      },
      "participants": {
        "$number": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['joinedAt']) && newData.child('joinedAt').isNumber()"
        }
      },
      "winner": {
        ".validate": "newData.hasChildren(['number', 'drawnAt'])"
      },
      "drawn": {
        "$number": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "chat": {
      ".write": "auth != null && auth.uid == '__ADMIN_UID__'",
      "$messageId": {
        ".write": "!data.exists() && (newData.child('type').val() == 'notice' ? (auth != null && auth.uid == '__ADMIN_UID__') : (newData.hasChild('chatId') && root.child('chatRate').child(newData.child('chatId').val()).val() > now - 5000))",
        ".validate": "newData.hasChildren(['timestamp']) && newData.child('timestamp').isNumber()",
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "type": {
          ".validate": "newData.val() == 'notice' || newData.val() == 'donate'"
        },
        "amount": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "chatId": {
          ".validate": "newData.isString()"
        },
        "hidden": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pinnedNotice": {
      ".write": "auth != null && auth.uid == '__ADMIN_UID__'",
      ".validate": "newData.hasChildren(['text', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length <= 100"
    },
    "chatRate": {
      "$chatId": {
        ".write": "!data.exists() || newData.val() - data.val() >= 10000",
        ".validate": "newData.isNumber() && newData.val() >= now - 2000"
      }
    }
  }
}
